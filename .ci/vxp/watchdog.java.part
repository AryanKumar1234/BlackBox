    // ---- VXPosed launch watchdog (injected by .ci/vxp/patch_engine.py) ----

    private final android.os.Handler mOpenWatchdog =
            new android.os.Handler(android.os.Looper.getMainLooper());
    private boolean mOpenWatchdogStopped;

    private void startOpenWatchdog(int userId) {
        final long launchedAt = android.os.SystemClock.elapsedRealtime();
        final String pkg = appModel.packageName;
        mOpenWatchdogStopped = false;
        mOpenWatchdog.postDelayed(new Runnable() {
            @Override
            public void run() {
                if (mOpenWatchdogStopped || isFinishing() || isDestroyed()) {
                    return;
                }
                long elapsed = android.os.SystemClock.elapsedRealtime() - launchedAt;
                boolean alive = false;
                try {
                    alive = VirtualCore.get().isAppRunning(pkg, userId);
                } catch (Throwable ignored) {
                }
                if (alive && elapsed >= 3500L) {
                    // The cloned app is up - hand the screen over even if the
                    // binder callback never arrived.
                    mOpenWatchdogStopped = true;
                    finish();
                    return;
                }
                if (elapsed >= 20000L) {
                    mOpenWatchdogStopped = true;
                    showOpenFailure(pkg, alive);
                    return;
                }
                mOpenWatchdog.postDelayed(this, 500L);
            }
        }, 500L);
    }

    private void stopOpenWatchdog() {
        mOpenWatchdogStopped = true;
        mOpenWatchdog.removeCallbacksAndMessages(null);
    }

    private void showOpenFailure(String pkg, boolean processAlive) {
        String details = "package: " + pkg
                + "\nandroid: " + android.os.Build.VERSION.RELEASE
                + " (API " + android.os.Build.VERSION.SDK_INT + ")"
                + "\ndevice: " + android.os.Build.MANUFACTURER + " " + android.os.Build.MODEL
                + "\nprocess alive: " + processAlive
                + "\n\n" + captureLogs(pkg);
        try {
            new android.support.v7.app.AlertDialog.Builder(this, R.style.Theme_AppCompat_DayNight_Dialog_Alert)
                    .setTitle("Couldn't open " + appModel.name)
                    .setMessage("The cloned app did not start. Copy the details and share them so the"
                            + " exact cause can be fixed.")
                    .setPositiveButton("Copy details", (dialog, which) -> {
                        try {
                            android.content.ClipboardManager cm =
                                    (android.content.ClipboardManager) getSystemService(CLIPBOARD_SERVICE);
                            if (cm != null) {
                                cm.setPrimaryClip(android.content.ClipData.newPlainText("vxp", details));
                                Toast.makeText(this, "Details copied", Toast.LENGTH_SHORT).show();
                            }
                        } catch (Throwable ignored) {
                        }
                        finish();
                    })
                    .setNegativeButton("Close", (dialog, which) -> finish())
                    .show();
        } catch (Throwable e) {
            finish();
        }
    }

    private String captureLogs(String pkg) {
        StringBuilder sb = new StringBuilder("--- logcat ---\n");
        Process process = null;
        try {
            process = Runtime.getRuntime().exec(new String[]{"/system/bin/logcat", "-d", "-t", "500"});
            java.io.BufferedReader reader =
                    new java.io.BufferedReader(new java.io.InputStreamReader(process.getInputStream()));
            String line;
            int kept = 0;
            while ((line = reader.readLine()) != null) {
                if (line.contains(pkg) || line.contains("FATAL")
                        || line.contains("AndroidRuntime") || line.contains(" VA/")) {
                    sb.append(line).append('\n');
                    if (++kept > 150) {
                        break;
                    }
                }
            }
            reader.close();
        } catch (Throwable e) {
            sb.append("(log unavailable: ").append(e).append(")\n");
        } finally {
            if (process != null) {
                try {
                    process.destroy();
                } catch (Throwable ignored) {
                }
            }
        }
        return sb.toString();
    }

    // ---- end VXPosed launch watchdog ----
