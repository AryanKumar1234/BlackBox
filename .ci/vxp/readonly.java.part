    /**
     * Android 14+ (API 34+) refuses to load code from a writable file when the
     * process target SDK is 34 or higher: ART logs "Attempt to load writable dex
     * file" and aborts the process. Cloned APKs are copied into the host's
     * private storage, which is writable, so a modern cloned app used to die
     * while its class loader was being built. Marking the copies read-only just
     * before they are loaded keeps ART happy.
     */
    private void markCodeFilesReadOnly(InstalledAppInfo info) {
        if (info == null) {
            return;
        }
        java.util.List<String> paths = new java.util.ArrayList<>();
        if (info.apkPath != null) {
            paths.add(info.apkPath);
            try {
                File appDir = new File(info.apkPath).getParentFile();
                File[] files = appDir == null ? null : appDir.listFiles();
                if (files != null) {
                    for (File file : files) {
                        String name = file.getName();
                        if (file.isFile() && (name.endsWith(".apk") || name.endsWith(".jar")
                                || name.endsWith(".dex"))) {
                            paths.add(file.getAbsolutePath());
                        }
                    }
                }
            } catch (Throwable ignored) {
            }
        }
        if (info.splitCodePaths != null) {
            for (String split : info.splitCodePaths) {
                if (split != null) {
                    paths.add(split);
                }
            }
        }
        for (String path : paths) {
            try {
                com.lody.virtual.helper.utils.FileUtils.chmod(path, 0444);
            } catch (Throwable ignored) {
            }
        }
        VLog.i(TAG, "Code files marked read-only: " + info.packageName);
    }
